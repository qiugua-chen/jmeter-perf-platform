# ============================================================
# jmeter-perf-platform 环境变量样例
# 用法：cp .env.example .env 后按实填写；.env 已被 .gitignore 排除，严禁入库
# 变量名与 docker-compose.yml 的 ${...} 插值一一对应，改名须两边同步
# ============================================================

# ---- Jenkins 管理员账号（compose 强制必填，禁止弱密码）----
# 首启由 init.groovy.d/20-admin-password.groovy 创建；
# 每次启动按此值同步密码——"重启改密"只改这里然后 docker compose up -d 即可
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=

# ---- 脚本仓库只读凭据（可选）----
# 传递链：.env → 容器环境变量 → 构建 shell 继承 → scripts-sync.sh 消费
# 模板默认 GIT_URL=https://${GIT_USER:-git}:${GIT_TOKEN}@git.example.com/group/perf-scripts.git
# 公网仓库可留空 GIT_TOKEN，并把 GIT_URL 覆盖为不带凭据的地址（compose environment 加 GIT_URL）
GIT_USER=git
GIT_TOKEN=
